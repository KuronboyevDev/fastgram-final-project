# ─── Server 1 environment ───────────────────────────────────────────
# Copy this file to ".env" and fill in your real values.

# PostgreSQL connection (the MAIN database).
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Create the database "fastgram_main" in pgAdmin first.
DATABASE_URL="postgresql://postgres:bektemur@localhost:5432/fastgram_main"

# Port this server listens on
PORT=4000

# Secret used to sign JWT auth tokens (change to any long random string)
JWT_SECRET="super-secret-change-me-in-production"
JWT_EXPIRES_IN="7d"

# Redis connection. If Redis is NOT running, the app automatically falls back
# to an in-memory cache, so it still works. To use real Redis install Memurai
# (https://www.memurai.com) or point this at a Redis Cloud instance.
REDIS_URL="redis://localhost:6379"

# Where Server 2 (the GraphQL service) lives — used for microservice calls.
SERVER2_INTERNAL_URL="http://localhost:8000"

# Public base URL of THIS server, used to build absolute media URLs.
# In dev everything goes through the gateway, so we expose media via the gateway.
PUBLIC_MEDIA_BASE="http://localhost:8080"

# Comma-separated list of allowed CORS origins (the gateway + the frontend)
CORS_ORIGINS="http://localhost:3000,http://localhost:8080"
