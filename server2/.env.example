# ─── Server 2 environment ───────────────────────────────────────────
# Copy this file to ".env" and fill in your real values.

# PostgreSQL connection (the ANALYTICS database, separate from Server 1).
# Create the database "fastgram_analytics" in pgAdmin first.
DATABASE_URL=postgresql://postgres:bektemur@localhost:5432/fastgram_analytics

# Port this server listens on
PORT=8000

# Where Server 1 (the REST service) lives — used for microservice calls back.
SERVER1_INTERNAL_URL=http://localhost:4000

# Allowed CORS origins (gateway + frontend)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
